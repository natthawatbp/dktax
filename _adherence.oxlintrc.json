{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/web-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Prompt))/i]",
        "message": "Font not provided by the design system. Available: Prompt."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|icon|tone|size|centeredBody|footer|children|key|ref|className|style|children)$/]",
        "message": "<AppModal> doesn't accept that prop. Declared props: open, onClose, title, icon, tone, size, centeredBody, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppModal'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|danger|success|warning)$/]",
        "message": "<AppModal> tone must be one of 'primary' | 'danger' | 'success' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppModal'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<AppModal> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|loading|block|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, loading, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|secondary|danger|success|line|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'secondary' | 'danger' | 'success' | 'line' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|actions|padding|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, icon, actions, padding, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|title|align|width|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, title, align, width, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center|end)$/]",
        "message": "<DataTableColumn> align must be one of 'start' | 'center' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|active|title|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, tone, active, title, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|danger|warning|line|muted)$/]",
        "message": "<IconButton> tone must be one of 'primary' | 'danger' | 'warning' | 'line' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|icon|hint|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, size, icon, hint, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|width|maxWidth|onDark|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, width, maxWidth, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:long|seal)$/]",
        "message": "<Logo> variant must be one of 'long' | 'seal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|size|value|defaultValue|onChange|disabled|className|style|id|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, size, value, defaultValue, onChange, disabled, className, style, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Select> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|badge|tone|divider|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: key, label, icon, badge, tone, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|danger)$/]",
        "message": "<SidebarItem> tone must be one of 'default' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|icon|tone|sub|progress|selected|onClick|accent|variant|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, unit, icon, tone, sub, progress, selected, onClick, accent, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|orange|danger|info|muted)$/]",
        "message": "<StatCard> tone must be one of 'primary' | 'success' | 'warning' | 'orange' | 'danger' | 'info' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:none|top)$/]",
        "message": "<StatCard> accent must be one of 'none' | 'top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|filled|tile)$/]",
        "message": "<StatCard> variant must be one of 'default' | 'filled' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|icon|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:paid|unpaid|expiring|overdue|review|other)$/]",
        "message": "<StatusBadge> status must be one of 'paid' | 'unpaid' | 'expiring' | 'overdue' | 'review' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusFilter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|counts|onChange|key|ref|className|style|children)$/]",
        "message": "<StatusFilter> doesn't accept that prop. Declared props: value, counts, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusFilter'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:all|paid|unpaid|expiring|overdue|review|other)$/]",
        "message": "<StatusFilter> value must be one of 'all' | 'paid' | 'unpaid' | 'expiring' | 'overdue' | 'review' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavbarUser'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|avatar|online|fields|key|ref|className|style|children)$/]",
        "message": "<TopNavbarUser> doesn't accept that prop. Declared props: name, role, avatar, online, fields."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
